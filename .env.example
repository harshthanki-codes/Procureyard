# QuickDrop Rider Dispute Desk - Configuration Example

# Application Server
APP_NAME="QuickDrop Dispute Desk"
APP_PORT=8000
DEBUG=false

# Database Connection (PostgreSQL for production/docker, SQLite for local testing)
# Docker default:
DATABASE_URL=postgresql://quickdrop:quickdrop_secret_password@postgres:5432/quickdrop
# Local development fallback:
# DATABASE_URL=sqlite:///quickdrop.db

# Payment Gateway (PaySwift Sandbox)
PAYSWIFT_BASE_URL=http://localhost:8081

# Financial Guardrails
AUTO_PAY_MAX_AMOUNT=200
MAX_AUTO_PAYS_PER_RIDER_PER_DAY=1
LOOKBACK_DAYS_LIMIT=7

# Optional LLM API Keys (System includes built-in deterministic hybrid fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
